# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=

# ftrack
FTRACK_SERVER=
FTRACK_API_USER=
FTRACK_API_KEY=

# Runtime model
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Queue / worker
REDIS_URL=

# Authentication
AUTH_SECRET=

# Internal service authentication (Step 8C-3/8C-4/8C-5) -- one shared
# secret used on both sides of the trusted internal ftrack Version/
# ReviewNote sync endpoints: apps/api validates it on every request
# (X-Internal-Sync-Token header, fails closed if this is blank), and
# services/worker + services/ftrack-connector send it when calling those
# endpoints (also fails closed -- performs no ICAS write if this is
# blank). Distinct from AUTH_SECRET above. Set the same value here for
# all three services' local .env.
INTERNAL_SYNC_TOKEN=
