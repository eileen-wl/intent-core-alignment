# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=

# ftrack
FTRACK_SERVER=
FTRACK_API_USER=
FTRACK_API_KEY=

# Runtime model
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Queue / worker
REDIS_URL=

# Authentication
AUTH_SECRET=

# Internal service authentication (Step 8C-3) -- shared secret required
# by the trusted internal ftrack Version/ReviewNote sync endpoints
# (X-Internal-Sync-Token header). Distinct from AUTH_SECRET above.
# Blank fails closed: every request is rejected until this is set.
INTERNAL_SYNC_TOKEN=
